NODE_ENV=development
PORT=4000

# Matches the local PostgreSQL service in the repository's docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexbill"

# Matches the local Redis service
REDIS_URL="redis://localhost:6379"

# Generate a unique secret locally. Do not commit your real secret.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
