generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  FINANCE
  CUSTOMER
}

enum BillingPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  invitationsCreated BusinessInvitation[] @relation("InvitationCreator")
}

model Business {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  customers     Customer[]
  products      Product[]
  plans         Plan[]
  subscriptions Subscription[]
  invoices      Invoice[]
  invitations   BusinessInvitation[]
}

model Membership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       UserRole @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId, role])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  companyName String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices   Invoice[]

  @@index([businessId, email])
  @@unique([id, businessId])
  @@index([businessId, name])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  type        String
  salesPrice  Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  planItems   PlanItem[]
  subscriptionLines SubscriptionLine[]
  invoiceLines InvoiceLine[]

  @@unique([id, businessId])
  @@index([businessId, name])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  businessId String
  name       String
  priceAddOn Decimal @db.Decimal(12, 2)
  product    Product @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)
  @@index([productId])
}

model Plan {
  id             String        @id @default(cuid())
  businessId     String
  name           String
  price          Decimal       @db.Decimal(12, 2)
  billingPeriod  BillingPeriod
  minQuantity    Int           @default(1)
  availableFrom  DateTime?
  availableUntil DateTime?
  autoClose      Boolean       @default(false)
  earlyClose     Boolean       @default(false)
  allowPause     Boolean       @default(false)
  autoRenew      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items          PlanItem[]
  subscriptions  Subscription[]

  @@unique([id, businessId])
  @@index([businessId, name])
}

model PlanItem {
  id         String  @id @default(cuid())
  businessId String
  planId     String
  productId  String
  quantity   Decimal @default(1) @db.Decimal(12, 2)
  plan       Plan    @relation(fields: [planId, businessId], references: [id, businessId], onDelete: Cascade)
  product    Product @relation(fields: [productId, businessId], references: [id, businessId])
  @@unique([planId, productId])
  @@index([productId])
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String
  number     String
  customerId String
  planId     String
  startDate  DateTime
  expiryDate DateTime?
  status     SubscriptionStatus @default(DRAFT)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId, businessId], references: [id, businessId])
  plan       Plan               @relation(fields: [planId, businessId], references: [id, businessId])
  lines      SubscriptionLine[]
  invoices   Invoice[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, expiryDate])
  @@index([customerId, status])
}

model SubscriptionLine {
  id             String  @id @default(cuid())
  businessId     String
  subscriptionId String
  productId      String
  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  amount         Decimal @db.Decimal(12, 2)
  subscription   Subscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)
  product        Product      @relation(fields: [productId, businessId], references: [id, businessId])
  @@index([subscriptionId])
}

model Invoice {
  id               String        @id @default(cuid())
  businessId       String
  number           String
  customerId       String
  subscriptionId   String?
  recurringKey     String?
  billingPeriodKey String?
  periodStart      DateTime?
  periodEnd        DateTime?
  dueDate          DateTime
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @db.Decimal(12, 2)
  taxTotal         Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer      @relation(fields: [customerId, businessId], references: [id, businessId])
  subscription    Subscription? @relation(fields: [subscriptionId, businessId], references: [id, businessId])
  lines            InvoiceLine[]
  payments         Payment[]

  @@unique([businessId, number])
  @@unique([businessId, recurringKey])
  @@unique([id, businessId])
  @@index([businessId, status, dueDate])
  @@index([customerId, status])
  @@index([subscriptionId, billingPeriodKey])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  businessId  String
  invoiceId   String
  productId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)
  product     Product @relation(fields: [productId, businessId], references: [id, businessId])
  @@index([invoiceId])
}

model Payment {
  id                    String        @id @default(cuid())
  businessId            String
  invoiceId             String
  method                String
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(12, 2)
  provider              String?
  providerTransactionId String?
  idempotencyKey        String?       @unique
  paidAt                DateTime?
  note                  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  invoice               Invoice       @relation(fields: [invoiceId, businessId], references: [id, businessId])
  refunds               Refund[]
  @@unique([provider, providerTransactionId])
  @@index([invoiceId, status])
  @@index([invoiceId, paidAt])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  idempotencyKey   String       @unique
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, status])
}


model BusinessInvitation {
  id         String   @id @default(cuid())
  businessId String
  email      String
  role       UserRole
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedById String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId, email, acceptedAt])
  @@index([expiresAt])
}
